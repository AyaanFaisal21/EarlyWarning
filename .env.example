# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env

TL_API_KEY=
# Optional: leave blank and one is created on first run, then paste the id back here
TL_INDEX_ID=

OPENAI_API_KEY=
# Verified working: gpt-5.5. Note gpt-5.x rejects a custom temperature,
# so OPENAI_TEMPERATURE is left unset by default.
OPENAI_MODEL=gpt-5.5

# AWS — Bedrock agent + S3 footage origin
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Neo4j (defaults match docker-compose.yml)
# Local docker, or Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hackathon2026
